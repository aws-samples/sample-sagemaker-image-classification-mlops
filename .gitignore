# Python
__pycache__/
*.py[cod]
*.so
*.egg
*.egg-info/
venv/
env/
.conda/

# IDE
.idea/
.vscode/
*.swp
*.swo

# Data & Models
# Note: the `data/` directory itself is ignored (too big for git), but DVC
# metadata files (`data.dvc`, `.dvc/*` except `.dvc/cache` and `.dvc/tmp`)
# MUST be committed — they're the pointer that says "this exact git commit
# trained against this exact S3 dataset hash".
data/
!data.dvc
models/
*.h5
*.pkl
*.joblib
*.weights

# Terraform
.terraform/
.terraform.lock.hcl
*.tfstate
*.tfstate.*
tfplan
*.tfplan

# AWS
.aws/

# Build Artifacts
*.tar.gz
output/
artifacts/

# Lambda packages (generated by Terraform/CodeBuild)
modules/**/*.zip
stack-inference/lambda-layers/*.zip

# Logs
*.log
*.out
*.err

# OS
.DS_Store
Thumbs.db

# Temporary
*.tmp
*.temp
*~

# Environment
.env
.env.local
.env.*.local

# Kiro
.kiro/
.apex/
.workflow-state/
project-doc/
.gitkeep

# Mirador security exports (contain account-internal data)
mirador-resources-export-*.csv
mirador-resources-export-*.json

# Blog content — not part of the deployable codebase
blog_docs/
charts/
*.docx
