# terraform.tfvars in this folder is the complete working configuration
# (pipeline_steps and models are required and defined there). This file lists
# the settings you are most likely to change; copy the lines you need into
# terraform.tfvars.

project_name = "medical-image-classification"
environment  = "dev"
aws_region   = "us-east-1"

# Audit and cost governance. The trail is account-wide and multi-region; turn
# it on only when no organization trail records this account.
enable_cloudtrail         = false
cloudtrail_retention_days = 400
monthly_budget_usd        = 200
budget_alert_emails       = [] # e.g., ["oncall@example.com"]
budget_start_date         = "2026-01-01_00:00" # YYYY-MM-DD_HH:MM (UTC)

# Training data prefix in the raw data bucket
training_data_path = "medical_image_data/"

# Cost levers
enable_managed_spot_training = true
enable_auto_trigger          = true

# Object whose creation starts the pipeline (scripts/data_uploader.sh writes it
# after a batch upload).
auto_trigger_marker_key = "medical_image_data/.batch_complete"

# Managed MLflow tracking server. Billed for every hour it runs.
enable_mlflow = false

# Security
kms_deletion_window_days = 30
enable_kms_key_rotation  = true

# Training jobs run without outbound network access. Upload the ImageNet
# weights once first: python scripts/download_pretrained_weights.py
enable_network_isolation = true

# Optional: run training and processing jobs in your VPC. The subnets need
# routes to S3, SageMaker, CloudWatch Logs, ECR and PyPI (or a mirror).
# vpc_config = {
#   subnet_ids         = ["subnet-0123456789abcdef0"]
#   security_group_ids = ["sg-0123456789abcdef0"]
# }

# Keep buckets (and their data) when the stack is destroyed. Set
# force_destroy = true only for a throwaway environment.
bucket_defaults = {
  force_destroy       = false
  enable_versioning   = true
  block_public_access = true
}

# SageMaker container images (optional; floating major.minor tags shown)
# sagemaker_images = {
#   tensorflow_gpu_tag       = "2.19.0-gpu-py312-cu125-ubuntu22.04-sagemaker"
#   tensorflow_cpu_tag       = "2.19.0-cpu-py312-ubuntu22.04-sagemaker"
#   tensorflow_inference_tag = "2.19.0-cpu-py312-ubuntu22.04-sagemaker"
# }
